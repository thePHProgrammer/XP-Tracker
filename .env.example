# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Database (your own free Neon or Supabase Postgres account) ---
# Pooled connection string - used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/dbname?sslmode=require"
# Direct/unpooled connection string - used only by the Prisma CLI for migrations.
DIRECT_URL="postgresql://user:password@host.example.com/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: only needed if you want "Sign in with Google" in addition to
# email+password. Leave unset to skip Google entirely.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
